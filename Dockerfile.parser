FROM python:3.13-slim@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a AS parser-runtime

ARG PYMUPDF_VERSION=1.28.2

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /runtime
RUN pip install --no-cache-dir "pymupdf==${PYMUPDF_VERSION}"
COPY --chown=65532:65532 parser_runtime/main.py /runtime/main.py

USER 65532:65532
ENTRYPOINT ["python", "-I", "/runtime/main.py"]
