APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://campushire:campushire@localhost:5432/campushire
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
SESSION_COOKIE_NAME=campushire_session
CSRF_COOKIE_NAME=campushire_csrf
SESSION_TTL_HOURS=12
RESUME_STORAGE_PATH=.data/resumes
RESUME_MAX_BYTES=5242880
RESUME_MAX_PAGES=3
RESUME_MAX_VERSIONS=25
RESUME_JOB_MAX_ATTEMPTS=3
RESUME_WORKER_POLL_SECONDS=2
RESUME_WORKER_LEASE_SECONDS=300
MALWARE_SCANNER=marker
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
QDRANT_URL=http://localhost:6333
