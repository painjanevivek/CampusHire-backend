APP_ENV=development
# Use api for Vercel, worker for the external durable worker, or all locally.
PROCESS_ROLE=all
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://campushire:campushire@localhost:5432/campushire
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=64
REDIS_POOL_TIMEOUT_SECONDS=1
FRONTEND_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver","test"]
LOG_LEVEL=INFO
SESSION_COOKIE_NAME=campushire_session
CSRF_COOKIE_NAME=campushire_csrf
SESSION_TTL_HOURS=12
DEMO_LOGIN_ENABLED=false
DEMO_ADMIN_MFA_BYPASS=false
DEMO_STUDENT_EMAIL=student+demo@example.com
DEMO_STUDENT_PASSWORD=
DEMO_ADMIN_EMAIL=admin+demo@example.com
DEMO_ADMIN_PASSWORD=
RESUME_STORAGE_PATH=.data/resumes
RESUME_STORAGE_BACKEND=local
# Use api_key for Vercel; keep instance_principal on OCI compute.
OCI_AUTH_MODE=instance_principal
OCI_OBJECT_NAMESPACE=
OCI_OBJECT_BUCKET=
OCI_OBJECT_UPLOADS_ENABLED=true
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_KEY_FINGERPRINT=
OCI_REGION=
# Store the PEM value as a Vercel secret. Never commit a real private key.
OCI_PRIVATE_KEY=
OCI_PRIVATE_KEY_PASSPHRASE=
RESUME_MAX_BYTES=5242880
RESUME_MAX_PAGES=3
RESUME_MAX_VERSIONS=25
RESUME_JOB_MAX_ATTEMPTS=3
RESUME_WORKER_POLL_SECONDS=2
RESUME_WORKER_LEASE_SECONDS=300
RESUME_PARSER_BACKEND=subprocess
RESUME_PARSER_IMAGE=campushire-pdf-parser:local
RESUME_PARSER_TIMEOUT_SECONDS=20
RESUME_PARSER_MEMORY_MEGABYTES=256
RESUME_PARSER_CPUS=0.5
RESUME_PARSER_PIDS_LIMIT=32
PRIVACY_CLEANUP_MAX_ATTEMPTS=5
PRIVACY_CLEANUP_LEASE_SECONDS=300
MALWARE_SCANNER=marker
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_MS=15000
SEMANTIC_MATCH_REQUESTS_PER_MINUTE=10
QDRANT_URL=http://localhost:6333
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@campushire.invalid
EMAIL_MONTHLY_QUOTA=3000
EMAIL_OPTIONAL_SUPPRESSION_RATIO=0.8
EMAIL_DELIVERY_MAX_ATTEMPTS=5
EMAIL_DEADLINE_REMINDER_HOURS=24
EMAIL_REMINDER_SWEEP_SECONDS=900
EMAIL_REMINDER_BATCH_SIZE=500
EMAIL_DELIVERY_WEBHOOK_KEY=
MAINTENANCE_MESSAGE=
APPLICATION_WIZARD_V1=false
APPLICATION_PACKET_CLEANUP_SECONDS=3600
