meta {
  name: Resume existing application draft
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/opportunities/{{eligibleRoleId}}/application-draft
  body: none
  auth: none
}

headers {
  Origin: http://localhost:3000
  X-CSRF-Token: {{csrfToken}}
}

script:pre-request {
  const token = bru.cookies.get("campushire_csrf");
  if (!token) {
    throw new Error("The authenticated CSRF cookie is missing.");
  }
  bru.setVar("csrfToken", token);
}

tests {
  test("repeating draft creation resumes the same draft", function () {
    const draft = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(draft.id).to.equal(bru.getVar("applicationDraftId"));
    expect(draft.role_id).to.equal(bru.getVar("eligibleRoleId"));
  });
}
