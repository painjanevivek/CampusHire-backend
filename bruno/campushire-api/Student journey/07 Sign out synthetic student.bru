meta {
  name: Sign out synthetic student
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/auth/sign-out
  body: none
  auth: none
}

headers {
  Origin: http://localhost:3000
  X-CSRF-Token: {{csrfToken}}
}

script:pre-request {
  const token = bru.cookies.get("campushire_csrf");
  if (!token) {
    throw new Error("The authenticated CSRF cookie is missing.");
  }
  bru.setVar("csrfToken", token);
}

tests {
  test("student session is revoked", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
