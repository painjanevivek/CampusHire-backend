meta {
  name: Read student profile
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/profile
  body: none
  auth: none
}

tests {
  test("profile belongs to the synthetic demo student", function () {
    const profile = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(profile.full_name).to.equal("Aarav Sharma");
    expect(profile.account_email).to.contain("@campushire.edu");
    expect(profile.revision).to.be.a("number");
    bru.setVar("studentName", profile.full_name);
    bru.setVar("studentCity", profile.city);
    bru.setVar("profileRevision", profile.revision);
  });
}
