meta {
  name: Reject unconfirmed onboarding review
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/onboarding/step
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: http://localhost:3000
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "expected_revision": {{onboardingRevision}},
    "step": 7,
    "review": {
      "confirmed": false
    }
  }
}

script:pre-request {
  const token = bru.cookies.get("campushire_csrf");
  if (!token) {
    throw new Error("The authenticated CSRF cookie is missing.");
  }
  bru.setVar("csrfToken", token);
}

tests {
  test("review cannot be saved without explicit confirmation", function () {
    expect(res.getStatus()).to.equal(422);
    expect(bru.getVar("onboardingRevision")).to.be.a("number");
  });
}
