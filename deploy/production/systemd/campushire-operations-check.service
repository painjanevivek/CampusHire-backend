[Unit]
Description=CampusHire production readiness, quota, backup, and certificate check
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=campushire
Group=campushire
WorkingDirectory=/opt/campushire/current
ExecStart=/opt/campushire/current/deploy/production/operations_check.sh /opt/campushire/config/production.env /var/lib/campushire/operations
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/campushire/operations
UMask=0077
