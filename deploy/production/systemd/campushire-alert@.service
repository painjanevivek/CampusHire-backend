[Unit]
Description=Deliver CampusHire failure alert for %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=campushire
Group=campushire
WorkingDirectory=/opt/campushire/current
ExecStart=/opt/campushire/current/deploy/production/send_failure_alert.sh /opt/campushire/config/production.env %i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077
