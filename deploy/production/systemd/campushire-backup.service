[Unit]
Description=CampusHire encrypted OCI PostgreSQL backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=campushire
Group=campushire
WorkingDirectory=/opt/campushire/current
ExecStart=/opt/campushire/current/deploy/production/backup.sh /opt/campushire/config/production.env
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077
