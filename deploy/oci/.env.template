# Public, non-secret OCI staging inputs. Keep populated deployment files outside Git.
STAGING_HOST=campushire-staging.example.org
FRONTEND_ORIGINS=["https://campushire-staging.example.org"]
TRUSTED_HOSTS=["campushire-staging.example.org"]

# Every release image must use a registry-qualified sha256 digest.
BACKEND_API_IMAGE=ghcr.io/painjanevivek/campushire-api@sha256:replace-me
BACKEND_WORKER_IMAGE=ghcr.io/painjanevivek/campushire-worker@sha256:replace-me
FRONTEND_IMAGE=ghcr.io/painjanevivek/campushire-frontend@sha256:replace-me
RESUME_PARSER_IMAGE=ghcr.io/painjanevivek/campushire-parser@sha256:replace-me
CLAMAV_IMAGE=ghcr.io/painjanevivek/campushire-clamav@sha256:replace-me

# A separately authenticated rootless Docker API on the same VM or an isolated host.
PARSER_DOCKER_HOST=tcp://host.docker.internal:2376
PARSER_CLIENT_CERT_DIR=/etc/campushire/parser-client-tls
STAGING_SECRET_DIR=/etc/campushire/secrets
CADDYFILE_PATH=../oci/Caddyfile

# Secret-manager injected values. Never commit a populated deployment file.
DATABASE_URL=postgresql+asyncpg://campushire:replace-me@postgres:5432/campushire
REDIS_URL=redis://:replace-me@redis:6379/0
GEMINI_API_KEY=
